{
  "name": "FF90-04 WordPress Draft",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "ff90-04-subworkflow-trigger",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.ff90.online/api/automation/wp-draft",
        "authentication": "genericCredentialType",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"run_id\": $json.run_id,\n  \"editorial_item_id\": $json.editorial_item_id,\n  \"title\": $json.title_th,\n  \"content\": $json.body_th,\n  \"slug\": $json.slug,\n  \"excerpt\": $json.excerpt_th,\n  \"news_type\": $json.news_type\n}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "ff90-04-draft",
      "name": "POST /api/automation/wp-draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ],
      "notes": "Idempotent via decideWpDraft() — same run_id returns the same wp_post_id. status is hard-coded 'draft' by the server. NEVER publish from this workflow.",
      "credentials": {
        "httpHeaderAuth": {
          "id": "oDa6RRKZleN2DC71",
          "name": "FF90 Automation Secret"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const current = { ...$('Validate editorial fields').item.json, ...$json };\n// Image metadata, written into the FF90 image-system registry when applicable.\nconst meta = {\n  alt_text: current.alt_text || '',\n  caption: current.caption || '',\n  credit_line: current.credit_line || '',\n  source_kind: current.source_kind || 'ai_generated',\n  source_url: current.source_url || null,\n  original_url: current.original_url || null,\n  author: current.author || null,\n  license: current.license || null,\n  license_url: current.license_url || null,\n  attribution: current.attribution || null,\n  provider: current.provider || null,\n  provider_request_id: current.provider_request_id || null,\n};\nreturn [{ json: { ...current, image_meta: meta } }];\n"
      },
      "id": "ff90-04-meta",
      "name": "Image metadata",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.source_kind }}",
              "rightValue": "ai_generated",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            },
            {
              "leftValue": "={{ $json.binary_data }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ff90-04-have-asset",
      "name": "Have asset bytes?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1020,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.ff90.online/api/automation/media",
        "authentication": "genericCredentialType",
        "sendBody": true,
        "specifyBody": "multipart-form-data",
        "multipartParameters": {
          "parameters": [
            {
              "parameterType": "formData",
              "name": "post_id",
              "value": "={{ $('POST /api/automation/wp-draft').item.json.wp_post_id }}"
            },
            {
              "parameterType": "formData",
              "name": "alt_text",
              "value": "={{ $json.alt_text }}"
            },
            {
              "parameterType": "formData",
              "name": "caption",
              "value": "={{ $json.caption }}"
            },
            {
              "parameterType": "formData",
              "name": "title",
              "value": "FF90 News Cover"
            }
          ]
        },
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": []
        }
      },
      "id": "ff90-04-upload",
      "name": "POST /api/automation/media",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1280,
        200
      ],
      "notes": "Phase 18C.1: uses the dedicated automation-authenticated media route (x-automation-secret only, no admin cookie/CSRF). Underlying WP upload is delegated to WordPressWriteClient.uploadMedia (same helper used by the admin media route; no duplicate upload code). This node never publishes.",
      "credentials": {
        "httpHeaderAuth": {
          "id": "oDa6RRKZleN2DC71",
          "name": "FF90 Automation Secret"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.ff90.online/api/automation/log",
        "authentication": "genericCredentialType",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"run_id\": $json.run_id,\n  \"action\": \"ff90_04_wp_draft_complete\",\n  \"stage\": \"wp_draft\",\n  \"status\": \"success\",\n  \"message\": \"WP draft created or reused; status=draft\",\n  \"metadata\": {\n    \"wp_post_id\": $('POST /api/automation/wp-draft').item.json.wp_post_id,\n    \"wp_status\": \"draft\",\n    \"idempotent\": $('POST /api/automation/wp-draft').item.json.idempotent || false\n  }\n}",
        "options": {
          "timeout": 15000
        },
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "ff90-04-log",
      "name": "Audit log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1480,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "oDa6RRKZleN2DC71",
          "name": "FF90 Automation Secret"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.ff90.online/api/automation/log",
        "authentication": "genericCredentialType",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"run_id\": $json.run_id,\n  \"action\": \"ff90_04_wp_draft_no_asset\",\n  \"stage\": \"wp_draft\",\n  \"status\": \"held_for_human\",\n  \"message\": \"No image asset available; WP draft created without featured image\",\n  \"metadata\": {\n    \"wp_post_id\": $('POST /api/automation/wp-draft').item.json.wp_post_id\n  }\n}",
        "options": {
          "timeout": 15000
        },
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "ff90-04-log-noimg",
      "name": "Audit log (no image)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1480,
        440
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "oDa6RRKZleN2DC71",
          "name": "FF90 Automation Secret"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Phase 18G — pre-flight validation. Stop safely BEFORE wp-draft\n// if required editorial fields are missing. Returns canonical\n// envelope with pipeline_status='held_for_content' in that case.\nconst up = $json;\nconst required = ['title_th', 'body_th'];\nconst missing = required.filter(k => !up[k] || String(up[k]).trim() === '');\nif (missing.length > 0) {\n  return [{\n    json: {\n      ...up,\n      pipeline_stage: 'wp_draft',\n      pipeline_status: 'held_for_content',\n      validation_error: 'missing_required_fields',\n      missing_fields: missing,\n    },\n  }];\n}\n// All required fields present. Proceed.\nreturn [{\n  json: {\n    ...up,\n    pipeline_stage: 'wp_draft',\n    pipeline_status: 'accepted',\n  },\n}];\n"
      },
      "id": "ff90-04-validate",
      "name": "Validate editorial fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "notes": "Phase 18G: stop safely if title_th/body_th missing. Production safety — never create a WordPress post with empty body."
    },
    {
      "parameters": {
        "jsCode": "// Phase 18G — terminal promote. Re-emits canonical envelope with\n// wp_post_id + wp_post_status='draft' from the wp-draft response.\n//\n// Pull wp-draft response via cross-node ref so we capture wp_post_id.\nconst up = $('Image metadata').item.json;\nconst draftResp = $('POST /api/automation/wp-draft').item.json || {};\nreturn [{\n  json: {\n    ...up,\n    run_id: up.run_id || draftResp.run_id || null,\n    editorial_item_id: up.editorial_item_id || draftResp.editorial_item_id || null,\n    wp_post_id: draftResp.wp_post_id || null,\n    wp_post_status: draftResp.status === 'draft' ? 'draft' : 'draft',  // hardcoded\n    pipeline_stage: 'wp_draft',\n    pipeline_status: 'waiting_approval',\n  },\n}];\n"
      },
      "id": "ff90-04-promote",
      "name": "Promote FF90-04 output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1840,
        300
      ],
      "notes": "Phase 18G: terminal promote. wp_post_status is hardcoded 'draft' — server enforces this in wp-draft route."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.pipeline_status }}",
              "rightValue": "accepted",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ff90-04-content-gate",
      "name": "Editorial fields valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        900,
        600
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { ...$json } }];\n"
      },
      "id": "ff90-04-stop:-missing-editorial-content",
      "name": "STOP: missing editorial content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        600
      ]
    }
  ],
