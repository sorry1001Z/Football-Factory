      "id": "ff90-02-run-state",
      "name": "GET /api/automation/run/{run_id}",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ],
      "notes": "Phase 18G: migrated from /api/admin/automation/{run_id} (admin session auth) to /api/automation/run/{run_id} (x-automation-secret + AUTOMATION_ENABLED kill-switch). The new route returns the same {run, editorialItem, recentEvents} shape as the admin route.",
      "credentials": {
        "httpHeaderAuth": {
          "id": "oDa6RRKZleN2DC71",
          "name": "FF90 Automation Secret"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Phase 18G — classify news type while preserving canonical envelope.\n// Reads upstream $json (envelope from FF90-01). Sets news_type.\n// In production: only classifies when editorial content is already\n// populated (via admin UI); when missing AND no test_marker, returns\n// pipeline_status=held_for_content and the chain short-circuits.\nconst input = $('Preserve editorial input').item.json;\nconst item = $json.editorialItem || {};\nconst saved = item.metadata || {};\nconst up = { ...input };\nfor (const key of ['news_type', 'title_th', 'body_th', 'excerpt_th', 'slug']) {\n  up[key] = saved[key] ?? item[key] ?? input[key];\n}\nconst src = up.source_url ? up : (up.raw || {});  // tolerate upstream shape\nconst optMeta = up.optional_metadata || src.optional_metadata || {};\nconst testMarker = optMeta.phase === '18f-b' && typeof optMeta.test_marker === 'string' && optMeta.test_marker.trim() && up.source_url?.startsWith('https://test.ff90.online/') && optMeta.test_content;\nconst testContent = testMarker ? optMeta.test_content : null;\n\n// News type enum: RESULT | PREVIEW | ANALYSIS | TRANSFER | BREAKING\n// (plus 'test' for Phase 18F-B synthetic fixtures).\n// Determine canonical editorial fields. Production: must already be\n// present on the editorial_item (admin UI pre-populated). Test fixture:\n// pull from optional_metadata.test_content.\nconst fields = {\n  news_type: src.news_type || up.news_type || (testContent ? testContent.news_type : null) || 'RESULT',\n  title_th: src.title_th || up.title_th || (testContent ? testContent.title_th : null) || null,\n  body_th: src.body_th || up.body_th || (testContent ? testContent.body_th : null) || null,\n  excerpt_th: src.excerpt_th || up.excerpt_th || (testContent ? testContent.excerpt_th : null) || null,\n  slug: src.slug || up.slug || (testContent ? testContent.slug : null) || null,\n};\n\n// Fail-closed: in production (no test_marker) if any required editorial\n// field is missing, hold for content.\nconst hasAllContent = [fields.title_th, fields.body_th].every(v => typeof v === 'string' && v.trim().length > 0);\nconst failClosed = !hasAllContent;\n\nreturn [{\n  json: {\n    ...up,\n    ...fields,\n    pipeline_stage: 'editorial_factory',\n    pipeline_status: failClosed ? 'held_for_content' : 'accepted',\n    metadata: { ...(up.metadata || {}), test_marker: !!testMarker },\n  },\n}];\n"
      },
      "id": "ff90-02-classify",
      "name": "Classify news type",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build the LLM article prompt (Thai). NEVER invents quotes, statistics,\n// transfers, or injuries. Notes the news_type for downstream template routing.\nconst newsType = $json.news_type;\nconst src = $json.source || $json;\nconst titleHint = src.source_title || '';\nconst text = src.source_text || '';\nconst prompt = [\n  'You are writing a Thai football news article for FF90.online.',\n  `News type: ${newsType}.`,\n  'Hard rules:',\n  ' - natural Thai, football-news style',\n  ' - clear paragraphs (no giant wall of text)',\n  ' - no invented quote',\n  ' - no invented statistic',\n  ' - no fabricated transfer or injury information',\n  ' - no long verbatim copying of source text',\n  ' - 2,000-3,500 Thai characters when source material supports it',\n  '   (NEVER pad with fabricated content to reach a length target)',\n  '',\n  `Source title: ${titleHint}`,\n  `Publisher: ${src.publisher || '(unknown)'}`,\n  `Published at: ${src.published_at || '(unknown)'}`,\n  `Competition: ${src.competition || '(unknown)'}`,\n  `Teams: ${(src.teams || []).join(', ') || '(unknown)'}`,\n  `People: ${(src.people || []).join(', ') || '(unknown)'}`,\n  '',\n  'Source text:',\n  text.slice(0, 8000),\n].join('\\n');\nreturn [{ json: { ...$json, article_prompt: prompt } }];\n"
      },
      "id": "ff90-02-prompt",
      "name": "Build article prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1020,
        300
      ]
    },
