    {
      "parameters": {
        "jsCode": "// Phase 18G — terminal promote. Re-emits canonical envelope with\n// pipeline_status chosen upstream. Always preserves run_id, editorial_item_id,\n// source_*, news_type, title_th, body_th, excerpt_th, slug.\nconst up = $json;\n// Pull upstream editorial fields from the Classify news type output\n// (the most-recent canonical envelope in the chain).\nconst classified = $('Classify news type').item.json || {};\nconst merged = {\n  ...classified,\n  ...up,\n  run_id: classified.run_id || up.run_id || null,\n  editorial_item_id: classified.editorial_item_id || up.editorial_item_id || null,\n  source_id: classified.source_id ?? up.source_id ?? null,\n  source_url: classified.source_url ?? up.source_url ?? null,\n  source_title: classified.source_title ?? up.source_title ?? null,\n  publisher: classified.publisher ?? up.publisher ?? null,\n  published_at: classified.published_at ?? up.published_at ?? null,\n  source_type: classified.source_type ?? up.source_type ?? null,\n  source_text: classified.source_text ?? up.source_text ?? null,\n  news_type: classified.news_type ?? up.news_type ?? null,\n  title_th: classified.title_th ?? up.title_th ?? null,\n  body_th: classified.body_th ?? up.body_th ?? null,\n  excerpt_th: classified.excerpt_th ?? up.excerpt_th ?? null,\n  slug: classified.slug ?? up.slug ?? null,\n  pipeline_stage: 'editorial_factory',\n  pipeline_status: classified.pipeline_status || 'accepted',\n};\nreturn [{ json: merged }];\n"
      },
