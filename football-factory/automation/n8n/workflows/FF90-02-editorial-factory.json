          }
        ]
      ]
    },
    "Classify news type": {
      "main": [
        [
          {
            "node": "Build article prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build article prompt": {
      "main": [
        [
          {
            "node": "POST /api/automation/ai-assist",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /api/automation/ai-assist": {
      "main": [
        [
          {
            "node": "POST /api/automation/seo-check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /api/automation/seo-check": {
      "main": [
        [
          {
            "node": "POST /api/automation/fact-check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /api/automation/fact-check": {
      "main": [
        [
          {
            "node": "Audit log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
