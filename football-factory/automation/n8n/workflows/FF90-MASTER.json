{
  "name": "FF90-MASTER",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ff90-master-intake",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "ff90-master-webhook",
      "name": "Webhook: source job intake",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ],
      "notes": "Accepts a normalized job: { source_url, requested_by, optional_metadata }. We do NOT trust arbitrary public POSTs without auth — for production, gate this webhook behind n8n's built-in auth or a sibling auth node. Returns the run_id synchronously (200) so callers can poll the editorial item."
    },
    {
      "parameters": {
        "jsCode": "// Production webhook input is never allowed to enable the synthetic fixture path.\nconst input = items[0].json;\nconst body = input.body && typeof input.body === 'object' && !Array.isArray(input.body) ? input.body : input;\nconst optional = body.optional_metadata && typeof body.optional_metadata === 'object' && !Array.isArray(body.optional_metadata) ? { ...body.optional_metadata } : {};\ndelete optional.phase; delete optional.test_marker; delete optional.test_content;\nreturn [{ json: {\n  source_url: typeof body.source_url === 'string' ? body.source_url : '',\n  source_title: typeof body.source_title === 'string' ? body.source_title : '',\n  publisher: typeof body.publisher === 'string' ? body.publisher : '',\n  published_at: typeof body.published_at === 'string' ? body.published_at : null,\n  competition: typeof body.competition === 'string' || Array.isArray(body.competition) ? body.competition : '',\n  teams: Array.isArray(body.teams) ? body.teams : [],\n  people: Array.isArray(body.people) ? body.people : [],\n  source_text: typeof body.source_text === 'string' ? body.source_text : '',\n  source_type: typeof body.source_type === 'string' ? body.source_type : 'other',\n  requested_by: typeof body.requested_by === 'string' ? body.requested_by : 'anonymous',\n  optional_metadata: optional,\n  recovery_id: typeof body.recovery_id === 'string' && /^[0-9a-f-]{36}$/i.test(body.recovery_id) ? body.recovery_id : null,\n  test_mode: false,\n} }];\n"
      },
      "id": "ff90-master-norm",
      "name": "Normalize inbound job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "workflowId": "kwpSls38bmydgZK3",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "ff90-master-exec-01",
      "name": "Execute FF90-01 Source Intake",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        760,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Phase 18G — promote canonical envelope from FF90-01 output.\n// FF90-01 now emits the canonical envelope (via Promote FF90-01 output\n// Code node) instead of an Audit log response. We read it directly.\nconst result = $json;\nconst runId = result.run_id || null;\nconst editorialItemId = result.editorial_item_id || null;\n// Stop the chain on terminal non-accepted states from FF90-01.\nconst stopStates = ['duplicate', 'failed'];\nif (stopStates.includes(result.pipeline_status) || !editorialItemId) {\n  return [{\n    json: {\n      ...result,\n      status: 'duplicate_or_failed',\n      run_id: runId,\n      editorial_item_id: editorialItemId,\n      pipeline_stage: result.pipeline_stage || 'source_intake',\n      error_code: null,\n      retryable: false,\n      timestamp: new Date().toISOString(),\n    },\n  }];\n}\nreturn [{\n  json: {\n    ...result,\n    status: 'accepted',\n    run_id: runId,\n    editorial_item_id: editorialItemId,\n  },\n}];\n"
      },
      "id": "ff90-master-promote-01",
      "name": "Promote run context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1020,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.pipeline_status }}",
              "rightValue": "accepted",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ff90-master-gate-01",
      "name": "Continue?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1280,
        300
      ]
    },
    {
      "parameters": {
        "workflowId": "MfMkjlDg1SnEUk3r",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "ff90-master-exec-02",
      "name": "Execute FF90-02 Editorial Factory",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        1560,
        200
      ]
    },
    {
      "parameters": {
