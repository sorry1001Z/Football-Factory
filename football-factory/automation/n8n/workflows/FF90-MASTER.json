        "jsCode": "// This node is reachable only from the inactive test-harness subworkflow trigger.\nconst input = items[0].json;\nconst body = input.body && typeof input.body === 'object' && !Array.isArray(input.body) ? input.body : input;\nreturn [{ json: { ...body, test_mode: true, recovery_id: null } }];\n"
      },
