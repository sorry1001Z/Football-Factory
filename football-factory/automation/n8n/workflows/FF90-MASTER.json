        }
      },
      "id": "ff90-master-exec-03",
      "name": "Execute FF90-03 Image Factory",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        1840,
        200
      ]
    },
    {
      "parameters": {
        "workflowId": "YvfaWlJGZfUBEkSC",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "ff90-master-exec-04",
      "name": "Execute FF90-04 WordPress Draft",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        2120,
        200
      ]
    },
    {
      "parameters": {
        "workflowId": "HOc6FXMlouQJDMAl",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "ff90-master-exec-05",
      "name": "Execute FF90-05 Human Review Gate",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        2400,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Phase 18G — Final envelope. Re-emits canonical pipeline envelope\n// with all FF90-04 + FF90-05 fields preserved. No wp-publish call.\n// In manual_review mode this returns waiting_human_review.\nreturn [{\n  json: {\n    ...$json,\n    pipeline_stage: 'complete',\n    pipeline_status: $json.pipeline_status || 'waiting_human_review',\n    publish_mode: 'manual_review',\n    auto_publish: false,\n    timestamp: new Date().toISOString(),\n  },\n}];\n"
      },
      "id": "ff90-master-final",
      "name": "Final envelope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2680,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Duplicate / error early-out. The downstream stages are NOT executed.\nreturn [{\n  json: {\n    status: $json.status,\n    run_id: $json.run_id,\n    editorial_item_id: $json.editorial_item_id,\n    stage: 'source_intake',\n    error_code: null,\n    retryable: false,\n    timestamp: new Date().toISOString(),\n  },\n}];\n"
      },
      "id": "ff90-master-stop",
      "name": "STOP (duplicate / no editorial link)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        440
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.pipeline_status }}",
              "rightValue": "accepted",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ff90-master-gate-02",
      "name": "Editorial ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1840,
        200
      ],
      "notes": "Phase 18G: stop chain if FF90-02 returned held_for_content."
    },
    {
      "parameters": {
        "jsCode": "// Preserve the child envelope after the status endpoint response.\nconst held = $('Execute FF90-02 Editorial Factory').item.json;\nreturn [{ json: { ...held, run_status: 'held_for_content', pipeline_stage: 'editorial_factory', pipeline_status: 'held_for_content', error_code: 'editorial_held_for_content', timestamp: new Date().toISOString() } }];\n"
      },
      "id": "ff90-master-stop-editorial",
      "name": "STOP (held_for_content)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2080,
        440
      ],
      "notes": "Phase 18G: terminal stop when editorial content is missing."
    },
    {
