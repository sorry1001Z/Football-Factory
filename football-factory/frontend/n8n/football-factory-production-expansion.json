      "parameters": {
        "jsCode": "const x=$json.body||$json; const key=x.idempotency_key||x.source_id||x.url; if(!key) throw new Error('MISSING_IDEMPOTENCY_KEY'); return [{json:{...x,idempotency_key:String(key)}}];"
      },
