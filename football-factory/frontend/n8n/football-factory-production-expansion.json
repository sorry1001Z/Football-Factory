    {
      "parameters": {
        "jsCode": "const h=$json.headers||{}; const expected=$env.AUTOMATION_SECRET; const got=h['x-automation-secret']||h['X-Automation-Secret']; if(!expected||got!==expected) throw new Error('UNAUTHORIZED_WEBHOOK'); return items;"
      },
