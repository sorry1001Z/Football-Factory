# Football Factory — Environment Variables (placeholders only)
# DO NOT commit real values. Real values go in .env.local (gitignored) or
# in the Vercel project dashboard. See docs/ENVIRONMENT.md.

# ----- Frontend / Next.js (Vercel) -----
# Canonical site URL used in metadata, sitemap, robots, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://football-factory.vercel.app

# WordPress WPGraphQL endpoint. If empty, the frontend falls back to mock data.
WORDPRESS_GRAPHQL_URL=

# WordPress REST base URL (reserved for Phase 9).
WORDPRESS_REST_URL=

# Shared secret validated by Next.js on /api/revalidate.
# Must match FF_REVALIDATE_SECRET on the WordPress host.
WORDPRESS_REVALIDATE_SECRET=replace-with-a-long-random-secret

# ----- Automation flag (Slice 5 hardening) -----
# When this is set to exactly "true" (case-sensitive), all
# /api/automation/* mutation-capable endpoints are ENABLED.
# When missing OR set to anything else, they return 503
# { ok: false, error: "automation_disabled" }.
# Keep false until a separately approved, controlled automation window.
# Do not enable automation as part of a routine deployment.
AUTOMATION_ENABLED=false

# ----- PostgreSQL server-side connection -----
# DATABASE_URL must use PostgreSQL TLS. Certificate validation is enabled
# by the application by default; sslmode=disable is allowed only for local
# loopback databases outside production.
# PGSSLMODE may be require, verify-ca, or verify-full (default: verify-full).
# PGSSL_CA_CERT is an optional PEM trust root for private PostgreSQL CAs.
DATABASE_URL=
PGSSLMODE=
PGSSL_CA_CERT=

# ----- Football Data Providers (server-side, Phase 1) -----
# PRIMARY provider.
FOOTBALL_DATA_API_KEY=

# SECONDARY provider.
API_FOOTBALL_KEY=

# Provider mode: primary | secondary | mock | auto (default: auto).
FOOTBALL_PROVIDER_MODE=auto
