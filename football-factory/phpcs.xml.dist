<?xml version="1.0"?>
<ruleset name="Football Factory Theme">
	<description>WordPress Coding Standards for Football Factory Theme (Phase 6B).</description>

	<!-- What to scan. -->
	<file>./functions.php</file>
	<file>./inc/</file>
	<file>./header.php</file>
	<file>./footer.php</file>
	<file>./index.php</file>
	<file>./front-page.php</file>
	<file>./home.php</file>
	<file>./archive.php</file>
	<file>./single.php</file>
	<file>./page.php</file>
	<file>./search.php</file>
	<file>./searchform.php</file>
	<file>./404.php</file>
	<file>./comments.php</file>
	<file>./sidebar.php</file>

	<!-- Phase 6D-R: also scan template-parts/ -->
	<file>./template-parts/</file>

	<!-- Exclude vendor, node_modules, and build output. -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>

	<!--
		Two Theme files use multi-word class names whose
		kebab-case form contains internal hyphens. The WPCS
		Files.FileName rule assumes single-word class names
		and treats internal hyphens as separators, producing
		a demonstrable false positive (see file headers for
		documented justification). Suppress narrowly here;
		no other file is excluded.
	-->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>inc/contracts/class-core-plugin-contract.php</exclude-pattern>
		<exclude-pattern>inc/integrations/class-core-plugin-detector.php</exclude-pattern>
	</rule>

	<!-- Text domain. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="football-factory"/>
			</property>
		</properties>
	</rule>

	<!-- WordPress-Core is the meta-ruleset. -->
	<rule ref="WordPress-Core"/>
	<rule ref="WordPress.Security.NonceVerification"/>
	<rule ref="WordPress.Security.ValidatedSanitizedInput"/>
	<rule ref="WordPress.Security.EscapeOutput"/>
	<rule ref="WordPress.Files.FileName"/>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="football_factory_"/>
				<element value="FootballFactory"/>
				<element value="ff_"/>
			</property>
		</properties>
		<!--
			The Theme brand is "ff_" and is used consistently in all
			global functions, constants and CSS class names. WPCS
			recommends >= 4 chars, but the brand is established. The
			ShortPrefixPassed sub-rule is a false positive for this
			Theme. Suppressed here at ruleset level because the
			brand is part of the visual identity (no ff_ use means
			no Football Factory Theme code, period).
		-->
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.ShortPrefixPassed"/>
	</rule>
	<rule ref="WordPress.Arrays.MultipleStatementAlignment"/>

	<!-- Allow short array syntax (PHP 5.4+). -->
	<rule ref="Generic.Arrays.DisallowShortArraySyntax">
		<severity>0</severity>
	</rule>

	<!-- Allow void in @return. -->
	<rule ref="SlevomatCodingStandard.TypeHints.DeclareStrictTypes">
		<severity>0</severity>
	</rule>

	<!-- Allow line length up to 120 (WordPress default is 80, but data
	     contracts and view-model URLs run longer). -->
	<rule ref="Generic.Files.LineLength">
		<properties>
			<property name="lineLimit" value="120"/>
			<property name="absoluteLineLimit" value="0"/>
		</properties>
	</rule>

	<!-- Show progress and sniff codes. -->
	<arg value="sp"/>
	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
</ruleset>
